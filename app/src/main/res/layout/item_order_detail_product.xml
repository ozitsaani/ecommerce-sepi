<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/sepi_glass_fill"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <!-- Gambar Produk -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProductImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Sepi.Rounded16"
            tools:src="@drawable/ic_launcher_background" />

        <!-- Info Produk -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductName"
                style="@style/TextAppearance.Sepi.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textStyle="bold"
                tools:text="Earbuds Bluetooth TWS Sepi" />

            <TextView
                android:id="@+id/tvVariantLabel"
                style="@style/TextAppearance.Sepi.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/sepi_ink_soft"
                android:visibility="gone"
                tools:text="Warna: Hitam"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvQuantityAndPrice"
                style="@style/TextAppearance.Sepi.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/sepi_orange_700"
                android:textStyle="bold"
                tools:text="1x Rp199.000" />

        </LinearLayout>

        <!-- Tombol Tulis Ulasan (Hanya tampil jika pesanan DELIVERED) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWriteReview"
            style="@style/Widget.Sepi.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_write_review"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
