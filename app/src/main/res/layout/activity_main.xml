<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sepi_sky_50"
    tools:context="com.sepi.market.ui.main.MainActivity">

    <!-- 1. NavHostFragment Transparan -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- 2. Bottom Navigation Clay Melayang 72dp (DESIGN_CLAY.md) -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_clay_bar">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="8dp"
            android:background="@color/transparent"
            android:minHeight="0dp"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemBackground="@drawable/bg_bottom_nav_item_selector"
            app:itemIconSize="20dp"
            app:itemIconTint="@color/bottom_nav_icon_color_selector"
            app:itemPaddingBottom="4dp"
            app:itemPaddingTop="4dp"
            app:itemRippleColor="@color/transparent"
            app:itemTextAppearanceActive="@style/TextAppearance.Sepi.BottomNav.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.Sepi.BottomNav.Inactive"
            app:itemTextColor="@color/bottom_nav_text_color_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </FrameLayout>

</FrameLayout>
