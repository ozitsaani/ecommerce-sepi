<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Ubin Lingkaran Clay Bulat Sempurna (design/beranda.png) -->
    <FrameLayout
        android:id="@+id/layoutCategoryTile"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_clay_circle_sky"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_cat_tag"
            app:tint="@color/sepi_ink" />
    </FrameLayout>

    <!-- Label Nama Kategori (1 Baris Tengah, Ellipsize) -->
    <TextView
        android:id="@+id/tvCategoryName"
        style="@style/TextAppearance.Sepi.Caption"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/sepi_ink"
        android:textSize="12sp"
        android:fontFamily="@font/nunito_bold"
        tools:text="Elektronik" />

</LinearLayout>
