<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context="com.sepi.market.ui.auth.AuthActivity">

    <!-- Blobs latar belakang -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_blob_orange" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_blob_amber" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bg_blob_orange" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_xl">

            <!-- Logo & Brand Header -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_splash_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAppName"
                style="@style/TextAppearance.Sepi.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/app_name"
                android:textSize="28sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

            <TextView
                android:id="@+id/tvSlogan"
                style="@style/TextAppearance.Sepi.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_slogan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAppName" />

            <!-- Kartu Kaca Form Auth -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/sepi_glass_fill"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/card_elevation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSlogan">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Tab Toggle (Masuk | Daftar) -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabAuthMode"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:background="@drawable/bg_glass_input"
                        app:tabIndicatorColor="@color/sepi_orange_600"
                        app:tabIndicatorHeight="3dp"
                        app:tabRippleColor="@null"
                        app:tabSelectedTextColor="@color/sepi_orange_700"
                        app:tabTextColor="@color/sepi_ink_soft">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tab_sign_in" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tab_sign_up" />

                    </com.google.android.material.tabs.TabLayout>

                    <!-- Nama Lengkap (Khusus Daftar) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFullName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:hint="@string/full_name"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/sepi_glass_input"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                        app:boxCornerRadiusBottomStart="@dimen/radius_input"
                        app:boxCornerRadiusTopEnd="@dimen/radius_input"
                        app:boxCornerRadiusTopStart="@dimen/radius_input"
                        app:boxStrokeColor="@color/sepi_orange_600">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:textColor="@color/sepi_ink"
                            android:textSize="@dimen/text_base" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:hint="@string/email"
                        app:boxBackgroundColor="@color/sepi_glass_input"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                        app:boxCornerRadiusBottomStart="@dimen/radius_input"
                        app:boxCornerRadiusTopEnd="@dimen/radius_input"
                        app:boxCornerRadiusTopStart="@dimen/radius_input"
                        app:boxStrokeColor="@color/sepi_orange_600">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/sepi_ink"
                            android:textSize="@dimen/text_base" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Kata Sandi -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:hint="@string/password"
                        app:boxBackgroundColor="@color/sepi_glass_input"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                        app:boxCornerRadiusBottomStart="@dimen/radius_input"
                        app:boxCornerRadiusTopEnd="@dimen/radius_input"
                        app:boxCornerRadiusTopStart="@dimen/radius_input"
                        app:boxStrokeColor="@color/sepi_orange_600"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/sepi_ink"
                            android:textSize="@dimen/text_base" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Konfirmasi Kata Sandi (Khusus Daftar) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:hint="@string/confirm_password"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/sepi_glass_input"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                        app:boxCornerRadiusBottomStart="@dimen/radius_input"
                        app:boxCornerRadiusTopEnd="@dimen/radius_input"
                        app:boxCornerRadiusTopStart="@dimen/radius_input"
                        app:boxStrokeColor="@color/sepi_orange_600"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/sepi_ink"
                            android:textSize="@dimen/text_base" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Teks Error Server -->
                    <TextView
                        android:id="@+id/tvServerError"
                        style="@style/TextAppearance.Sepi.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:textColor="@color/sepi_danger"
                        android:visibility="gone"
                        tools:text="Email atau kata sandi salah"
                        tools:visibility="visible" />

                    <!-- Tombol Aksi Utama -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmit"
                            style="@style/Widget.Sepi.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_sign_in" />

                        <ProgressBar
                            android:id="@+id/pbLoading"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
