<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_sheet"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        style="@style/TextAppearance.Sepi.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shipping_address_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAddresses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:maxHeight="300dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_address_card" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddAddress"
        style="@style/Widget.Sepi.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/add_new_address"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconTint="@color/sepi_orange_700" />

</LinearLayout>
