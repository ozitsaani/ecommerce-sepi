<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header Bar Kaca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_header"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/sepi_ink" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/TextAppearance.Sepi.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/reviews_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWriteReviewTop"
            style="@style/Widget.Sepi.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="@string/write_review_title"
            android:textSize="12sp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconSize="14dp"
            app:iconTint="@color/sepi_orange_700" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Error State -->
            <com.sepi.market.ui.common.ErrorStateView
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star"
                    app:tint="@color/sepi_ink_soft" />

                <TextView
                    style="@style/TextAppearance.Sepi.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/empty_reviews" />
            </LinearLayout>

            <!-- Skeleton Shimmer -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerReviews"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_glass_card" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_glass_card" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_glass_card" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Scroll Konten Ulasan & Ringkasan -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_base"
                android:paddingBottom="80dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Kartu Ringkasan Ulasan & Distribusi Rating 5 s/d 1 -->
                    <LinearLayout
                        android:id="@+id/cardReviewSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md">

                        <!-- Kolom Kiri: Rating Rata-rata Besar & Bintang -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingEnd="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tvRatingAverage"
                                style="@style/TextAppearance.Sepi.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/sepi_orange_700"
                                android:textSize="36sp"
                                tools:text="4.8" />

                            <RatingBar
                                android:id="@+id/rbSummaryAverage"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:isIndicator="true"
                                android:numStars="5"
                                android:progressTint="@color/sepi_amber_400"
                                tools:rating="4.8" />

                            <TextView
                                android:id="@+id/tvTotalReviews"
                                style="@style/TextAppearance.Sepi.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/sepi_ink_soft"
                                tools:text="15 ulasan" />
                        </LinearLayout>

                        <!-- Garis Pemisah Vertikal -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:background="@color/sepi_glass_stroke" />

                        <!-- Kolom Kanan: Distribusi Bar 5 s/d 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Bar 5 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">
                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:text="5 ★" />
                                <ProgressBar
                                    android:id="@+id/pbRating5"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progressTint="@color/sepi_orange_500" />
                                <TextView
                                    android:id="@+id/tvCountRating5"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    tools:text="10" />
                            </LinearLayout>

                            <!-- Bar 4 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:text="4 ★" />
                                <ProgressBar
                                    android:id="@+id/pbRating4"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progressTint="@color/sepi_orange_500" />
                                <TextView
                                    android:id="@+id/tvCountRating4"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    tools:text="3" />
                            </LinearLayout>

                            <!-- Bar 3 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:text="3 ★" />
                                <ProgressBar
                                    android:id="@+id/pbRating3"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progressTint="@color/sepi_orange_500" />
                                <TextView
                                    android:id="@+id/tvCountRating3"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    tools:text="1" />
                            </LinearLayout>

                            <!-- Bar 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:text="2 ★" />
                                <ProgressBar
                                    android:id="@+id/pbRating2"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progressTint="@color/sepi_orange_500" />
                                <TextView
                                    android:id="@+id/tvCountRating2"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    tools:text="1" />
                            </LinearLayout>

                            <!-- Bar 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:text="1 ★" />
                                <ProgressBar
                                    android:id="@+id/pbRating1"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_marginHorizontal="6dp"
                                    android:layout_weight="1"
                                    android:max="100"
                                    android:progressTint="@color/sepi_orange_500" />
                                <TextView
                                    android:id="@+id/tvCountRating1"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    tools:text="0" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Daftar Ulasan Pembeli -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layoutAnimation="@anim/layout_animation_fade_in"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_review_card" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
