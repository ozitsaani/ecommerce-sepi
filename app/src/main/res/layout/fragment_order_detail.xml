<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sepi_sky_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar Clay Biru -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_clay_blue_header"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_base"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                style="@style/TextAppearance.Sepi.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:text="@string/tracking_title" />

        </LinearLayout>

        <!-- Swipe Refresh & Scroll Konten -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Error State -->
                <com.sepi.market.ui.common.ErrorStateView
                    android:id="@+id/errorView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Skeleton Shimmer -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerOrderDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_clay_card" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_clay_card" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_clay_card" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <!-- Scroll Detail Utama -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/contentScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="@dimen/spacing_base"
                    android:paddingBottom="80dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 1. Card Stepper Status 4 Langkah -->
                        <LinearLayout
                            android:id="@+id/cardStepper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_clay_card"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp">

                            <TextView
                                android:id="@+id/stepPaid"
                                style="@style/TextAppearance.Sepi.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/step_paid"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/stepPacked"
                                style="@style/TextAppearance.Sepi.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/step_packed" />

                            <TextView
                                android:id="@+id/stepShipped"
                                style="@style/TextAppearance.Sepi.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/step_shipped" />

                            <TextView
                                android:id="@+id/stepDelivered"
                                style="@style/TextAppearance.Sepi.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/step_delivered" />
                        </LinearLayout>

                        <!-- Tombol UNPAID: Bayar Sekarang -->
                        <LinearLayout
                            android:id="@+id/layoutUnpaidAction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                style="@style/TextAppearance.Sepi.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pesanan belum dibayar"
                                android:textColor="@color/status_unpaid_text"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPayNow"
                                style="@style/Widget.Sepi.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/btn_pay_now" />
                        </LinearLayout>

                        <!-- 2. Tombol Simulasi Mode Demo (Hanya untuk status PAID/PACKED/SHIPPED) -->
                        <LinearLayout
                            android:id="@+id/layoutDemoMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_discount"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="@string/demo_badge"
                                android:textColor="@color/sepi_danger"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAdvanceOrderDemo"
                                style="@style/Widget.Sepi.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/btn_demo_advance"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 3. Kartu Info Pesanan & Pengiriman -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp">

                            <!-- Kode Pesanan & Tombol Salin -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/order_code_label" />

                                <TextView
                                    android:id="@+id/tvOrderCode"
                                    style="@style/TextAppearance.Sepi.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:textStyle="bold"
                                    tools:text="SPI26100612345" />

                                <ImageView
                                    android:id="@+id/btnCopyOrderCode"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/btn_copy_code"
                                    android:padding="4dp"
                                    android:src="@drawable/ic_copy"
                                    app:tint="@color/sepi_brand_shade" />
                            </LinearLayout>

                            <!-- Tanggal Pembuatan -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Waktu Pemesanan" />

                                <TextView
                                    android:id="@+id/tvOrderDate"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    tools:text="6 Okt 2026, 09:15" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="@color/sepi_divider" />

                            <!-- Kurir -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Kurir Pengiriman" />

                                <TextView
                                    android:id="@+id/tvCourierName"
                                    style="@style/TextAppearance.Sepi.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    tools:text="Sepi Kurir (Express)" />
                            </LinearLayout>

                            <!-- Nomor Resi -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Nomor Resi" />

                                <TextView
                                    android:id="@+id/tvTrackingNumber"
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:textStyle="bold"
                                    tools:text="SPK1234567" />

                                <ImageView
                                    android:id="@+id/btnCopyTrackingNumber"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/btn_copy_code"
                                    android:padding="4dp"
                                    android:src="@drawable/ic_copy"
                                    android:visibility="gone"
                                    app:tint="@color/sepi_brand_shade"
                                    tools:visibility="visible" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- 4. Timeline Vertikal Pelacakan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp">

                            <TextView
                                style="@style/TextAppearance.Sepi.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/timeline_title"
                                android:textSize="@dimen/text_md" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvTrackingTimeline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="false"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_tracking_timeline" />

                        </LinearLayout>

                        <!-- 5. Alamat Tujuan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp">

                            <TextView
                                style="@style/TextAppearance.Sepi.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shipping_address_title"
                                android:textSize="@dimen/text_md" />

                            <TextView
                                android:id="@+id/tvRecipient"
                                style="@style/TextAppearance.Sepi.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textStyle="bold"
                                tools:text="Budi Santoso (081234567890)" />

                            <TextView
                                android:id="@+id/tvShippingAddress"
                                style="@style/TextAppearance.Sepi.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Jl. Siliwangi No. 45, Kesambi, Cirebon 45131" />

                        </LinearLayout>

                        <!-- 6. Rincian Barang & Tombol Tulis Ulasan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp">

                            <TextView
                                style="@style/TextAppearance.Sepi.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_items_title"
                                android:textSize="@dimen/text_md" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvOrderItems"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="false"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_order_detail_product" />

                        </LinearLayout>

                        <!-- 7. Rincian Pembayaran -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_clay_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingBottom="20dp">

                            <TextView
                                style="@style/TextAppearance.Sepi.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/payment_summary_title"
                                android:textSize="@dimen/text_md" />

                            <!-- Subtotal -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/subtotal" />

                                <TextView
                                    android:id="@+id/tvSubtotal"
                                    style="@style/TextAppearance.Sepi.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Rp199.000" />
                            </LinearLayout>

                            <!-- Ongkir -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/shipping_cost" />

                                <TextView
                                    android:id="@+id/tvShippingCost"
                                    style="@style/TextAppearance.Sepi.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Rp10.000" />
                            </LinearLayout>

                            <!-- Diskon -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/discount" />

                                <TextView
                                    android:id="@+id/tvDiscount"
                                    style="@style/TextAppearance.Sepi.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/sepi_success"
                                    tools:text="-Rp15.000" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="@color/sepi_divider" />

                            <!-- Total -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/TextAppearance.Sepi.Title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/total_payment"
                                    android:textSize="@dimen/text_md" />

                                <TextView
                                    android:id="@+id/tvTotalAmount"
                                    style="@style/TextAppearance.Sepi.Price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_lg"
                                    tools:text="Rp194.000" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</FrameLayout>
