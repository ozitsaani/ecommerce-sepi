<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_clay_sheet"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <!-- Handle Inset 4x40dp (PRD 10.7) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_inset_pill" />

    <TextView
        style="@style/TextAppearance.Sepi.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/write_review_title" />

    <!-- Rating Bar Bintang -->
    <TextView
        style="@style/TextAppearance.Sepi.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/rating_label" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:numStars="5"
        android:progressTint="@color/sepi_amber_400"
        android:rating="5"
        android:stepSize="1" />

    <!-- Isian Komentar -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/comment_label"
        app:boxBackgroundColor="@color/sepi_sky_100"
        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
        app:boxCornerRadiusBottomStart="@dimen/radius_input"
        app:boxCornerRadiusTopEnd="@dimen/radius_input"
        app:boxCornerRadiusTopStart="@dimen/radius_input"
        app:boxStrokeColor="@color/sepi_input_stroke"
        app:counterEnabled="true"
        app:counterMaxLength="300">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReviewComment"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|start"
            android:hint="@string/hint_comment"
            android:inputType="textMultiLine"
            android:maxLength="300"
            android:textColor="@color/sepi_ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitReview"
        style="@style/Widget.Sepi.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/submit_review" />

</LinearLayout>
