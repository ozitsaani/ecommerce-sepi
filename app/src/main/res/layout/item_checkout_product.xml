<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="7dp">

    <!-- Thumbnail Gambar Produk -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCheckoutProductImage"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Sepi.Rounded14"
        tools:src="@drawable/ic_launcher_background" />

    <!-- Informasi Produk & Varian -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCheckoutProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito"
            android:maxLines="1"
            android:textColor="@color/sepi_ink"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Sepatu Lari Ringa..." />

        <TextView
            android:id="@+id/tvCheckoutVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_variant"
            android:fontFamily="@font/nunito"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/sepi_brand_500"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Ukuran: 41" />

    </LinearLayout>

    <!-- Kuantitas & Harga (1 × Rp299.000) -->
    <TextView
        android:id="@+id/tvCheckoutPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito"
        android:textColor="@color/sepi_price"
        android:textSize="13.5sp"
        android:textStyle="bold"
        tools:text="1 × Rp299.000" />

</LinearLayout>
