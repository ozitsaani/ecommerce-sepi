<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Button (52dp, 20dp radius, bg_clay_button, white text 800) -->
    <style name="Widget.Sepi.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_clay_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Secondary Button (52dp, raised white, accent text) -->
    <style name="Widget.Sepi.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/sepi_text_accent</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="strokeColor">@color/transparent</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.Sepi.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/sepi_ink</item>
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/nunito_extrabold</item>
    </style>

    <style name="TextAppearance.Sepi.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/sepi_ink_soft</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="fontFamily">@font/nunito_semibold</item>
    </style>

    <style name="TextAppearance.Sepi.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/sepi_ink</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="fontFamily">@font/nunito_medium</item>
    </style>

    <style name="TextAppearance.Sepi.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/sepi_ink_soft</item>
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="fontFamily">@font/nunito_semibold</item>
    </style>

    <style name="TextAppearance.Sepi.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/sepi_price</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/nunito_extrabold</item>
    </style>

    <!-- Clay Bottom Sheet Dialog Theme -->
    <style name="Theme.Sepi.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Sepi.BottomSheet.Modal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
    </style>

    <style name="Widget.Sepi.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Shape Appearance for Rounded Image View -->
    <style name="ShapeAppearance.Sepi.Rounded16" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Sepi.Rounded14" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Sepi.Pill24" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="TextAppearance.Sepi.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>

    <style name="TextAppearance.Sepi.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
</resources>
