<?xml version="1.0" encoding="utf-8"?>
<!-- Ubin lingkaran clay warna biru muda Sky (DESIGN_CLAY.md) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan bawah (Shade 3D) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#B3D0F5" />
        </shape>
    </item>

    <!-- Badan lingkaran pastel -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/sepi_tile_sky" />
            <stroke
                android:width="1dp"
                android:color="@color/white" />
        </shape>
    </item>
</layer-list>
