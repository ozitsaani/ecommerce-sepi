<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sepi_clay_shade" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/sepi_clay_lo"
                android:startColor="@color/sepi_clay_hi"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/sepi_clay_rim" />
        </shape>
    </item>
</layer-list>
