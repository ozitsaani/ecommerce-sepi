<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/sepi_clay_shade" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:right="3dp">
        <shape>
            <solid android:color="@color/sepi_tile_lavender" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/sepi_clay_rim" />
        </shape>
    </item>
</layer-list>
