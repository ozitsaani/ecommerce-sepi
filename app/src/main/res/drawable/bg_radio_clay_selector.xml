<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="22dp"
                android:height="22dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFF" />
                    <stroke
                        android:width="2dp"
                        android:color="#2563EB" />
                </shape>
            </item>
            <item
                android:width="10dp"
                android:height="10dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#2563EB" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="22dp"
                android:height="22dp">
                <shape android:shape="oval">
                    <solid android:color="#F1F5F9" />
                    <stroke
                        android:width="2dp"
                        android:color="#CBD5E1" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
