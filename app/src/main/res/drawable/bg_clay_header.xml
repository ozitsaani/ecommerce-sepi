<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/sepi_clay_shade" />
            <corners
                android:bottomLeftRadius="32dp"
                android:bottomRightRadius="32dp" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:right="3dp">
        <shape>
            <gradient
                android:angle="315"
                android:endColor="@color/sepi_clay_lo"
                android:startColor="@color/sepi_clay_hi"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="32dp"
                android:bottomRightRadius="32dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/sepi_clay_rim" />
        </shape>
    </item>
</layer-list>
