<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/sepi_brand_shade" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:right="2dp">
                <shape>
                    <gradient
                        android:angle="315"
                        android:endColor="@color/sepi_brand_500"
                        android:startColor="@color/sepi_brand_400"
                        android:type="linear" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/sepi_clay_rim" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
