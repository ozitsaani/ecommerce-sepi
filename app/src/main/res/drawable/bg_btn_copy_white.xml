<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol clay putih kecil untuk aksi Salin kode voucher (design/beranda.png) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan bawah tipis -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1B4BC0" />
        </shape>
    </item>

    <!-- Badan putih dengan stroke halus -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="#E8F1FC" />
        </shape>
    </item>
</layer-list>
